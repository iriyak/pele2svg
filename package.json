{
  "name": "pele2svg",
  "version": "0.3.0",
  "description": "Convert SVG from pele (Mermaid renderer) into plain SVG without CSS, for renderers such as Skia / GToolkit",
  "type": "module",
  "main": "pele2svg.mjs",
  "exports": {
    ".": "./pele2svg.mjs"
  },
  "bin": {
    "pele2svg": "./pele2svg.mjs"
  },
  "files": [
    "pele2svg.mjs",
    "math.mjs",
    "themes",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pele": "^1.10.0"
  },
  "keywords": [
    "mermaid",
    "svg",
    "pele",
    "skia",
    "gtoolkit",
    "pharo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iriyak/pele2svg.git"
  },
  "bugs": {
    "url": "https://github.com/iriyak/pele2svg/issues"
  },
  "homepage": "https://github.com/iriyak/pele2svg#readme",
  "optionalDependencies": {
    "mathjax-full": "^3.2.2"
  }
}

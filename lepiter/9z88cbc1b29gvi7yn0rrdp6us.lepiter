								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T14:15:48.2+09:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "j7ugOare7EKkxgCM4fS3+A=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Give the full path of `bun` if it is not on the PATH that GToolkit sees. The theme is for Windows. `renderOptions` is one Dictionary: add other keys such as `#maxWidth` to it rather than setting it again. A single converter can still choose otherwise, for example `Pele2svg new runtime: 'node'; theme: nil; renderOptions: nil`; see {{gtClass:name=Pele2svgOptions}}."
						}
					]
				},

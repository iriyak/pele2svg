								"uidString" : "oes2Dkb1Cm1zVsUZJ1Nu7A=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "A formula does not have to be in a diagram. {{gtMethod:name=Pele2svg>>elementForTex:}} answers a `BlSkiaSvgElement` as big as the formula, and {{gtMethod:name=Pele2svg>>elementFor:format:}} also reads MathML (`#mathml`) and AsciiMath (`#asciimath`). Put the elements in any Bloc layout. The last one is in the display style, 28 px, in color:"
						},
						{
							"__type" : "pharoSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T16:10:46.772+09:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T16:10:46.772+09:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "WUX+wrW5/y/1p2DUYa9BNQ=="
							},
							"code" : "| pele row |\npele := Pele2svg new.\nrow := BlElement new\n\tlayout: (BlLinearLayout horizontal cellSpacing: 24);\n\tconstraintsDo: [ :c | c horizontal fitContent. c vertical fitContent ];\n\tpadding: (BlInsets all: 12).\nrow addChildren: {\n\tpele elementForTex: 'E=mc^2'.\n\tpele elementFor: '<math><msqrt><mi>x</mi></msqrt></math>' format: #mathml.\n\tpele elementFor: 'sum_(i=1)^n i^3=((n(n+1))/2)^2' format: #asciimath.\n\tpele\n\t\telementFor: '\\int_0^1 x^2\\,dx=\\frac13' format: #tex\n\t\tdisplay: true size: 28 color: '#205ea6' }.\nrow"
						},

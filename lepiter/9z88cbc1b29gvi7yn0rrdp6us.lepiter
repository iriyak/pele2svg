								"__type" : "uid",
								"uidString" : "gKXg/XHaMUSg/xEjx1KsAg=="
							},
							"code" : "| source |\nsource := 'sequenceDiagram\n  participant A as Customer service\n  participant B as Billing\n  A->>B: A rather long message that asks for the invoice\n  B-->>A: ok'.\nBlElement new\n\tlayout: BlLinearLayout horizontal;\n\tconstraintsDo: [ :c | c horizontal fitContent. c vertical fitContent ];\n\taddChildren: ({ 360. 1000 } collect: [ :width |\n\t\t(Pele2svg new renderOptions: { #maxWidth -> width } asDictionary; asElement: source)\n\t\t\tmargin: (BlInsets all: 10) ]);\n\tyourself"
						},

							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "`#maxWidth` lays a diagram out for that width in pixels; several diagram types then switch to narrow layouts (sequence, journey, swimlane, packet, tree view and others). Compare the same diagram at two widths:"
						},
						{
							"__type" : "pharoSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},

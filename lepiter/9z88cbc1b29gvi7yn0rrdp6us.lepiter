							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "#### Bun, the Windows theme and formulas (optional)"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T13:39:57.679+09:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T14:15:47.598+09:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "hb5qG+qgLkaYvg68mKGUHQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "[Bun](https://bun.sh/) starts faster than Node.js, which adds up when you render many diagrams. `themes/gt-windows.json` maps `monospace` to `Consolas` and `sans-serif` to `Arial`, so that Skia draws the text with the fonts a browser on Windows uses. `#math -> true` typesets `$$...$$` in labels as formulas (see **Formulas and narrow layouts** below); it costs nothing for a diagram without `$$`, because MathJax is loaded only when the source contains one. Evaluating this makes all three the default of every {{gtClass:name=Pele2svg}} in the image; put it in the startup script of your image (for example a `startup.st`) to keep it:"
						},
						{
							"__type" : "pharoSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T13:39:57.884+09:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T14:15:47.881+09:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "65xVLVvY1Ea0Mv6Cp5B1LA=="
							},
							"code" : "Pele2svgOptions globalDefault\n\tat: #runtime put: 'bun';\n\tat: #theme put: (Pele2svg repositoryDirectory / 'themes' / 'gt-windows.json') fullName;\n\tat: #renderOptions put: { #math -> true } asDictionary"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-25T13:39:58.068+09:00"
								}
							},
